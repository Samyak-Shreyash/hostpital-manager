# Copy to .env for local development. Never commit real values.
# The backend reads these from the environment (see backend/src/main/resources/application.yml);
# the Compose dev stack (infra/compose/compose.yml) reads all of its values from this file.

# PostgreSQL (database must exist; Flyway creates the `hms` schema). Roles per ADR-0015:
# the role names are fixed (the baseline migration grants to them), only the passwords vary.
HMS_DB_NAME=
# Runtime login used by the API: DML only. Must be hms_app.
HMS_DB_USERNAME=hms_app
HMS_DB_PASSWORD=
# Migration login used by Flyway at startup: owns the schema. Must be hms_owner.
HMS_DB_MIGRATION_USERNAME=hms_owner
HMS_DB_MIGRATION_PASSWORD=
# Compose dev stack only: Postgres superuser that creates the two roles on first start
# (infra/docker/db-init). Never given to the API. Changing roles needs `down -v` to re-run the init script.
HMS_DB_ADMIN_USERNAME=
HMS_DB_ADMIN_PASSWORD=
HMS_DB_PORT=
# Used when the backend runs on the host; Compose overrides it to point at the `db` service.
HMS_DB_URL=

# HTTP port of the backend (inside its container it is always 8080)
HMS_SERVER_PORT=

# Compose dev stack: host port of the reverse proxy
HMS_PROXY_PORT=

# Compose dev stack, `--profile monitoring` only ([E0-7]): Grafana login and host port
HMS_GRAFANA_ADMIN_USERNAME=
HMS_GRAFANA_ADMIN_PASSWORD=
HMS_GRAFANA_PORT=

# Sessions ([E1-3]). Optional: leave commented out for the defaults (an empty value would fail startup).
# Set HMS_SESSION_COOKIE_SECURE=false only when serving over plain http on a non-localhost host.
# HMS_SESSION_IDLE_TIMEOUT=30m
# HMS_SESSION_COOKIE_SECURE=true

# Application-level field encryption ([E3-2], ADR-0009): ABHA numbers are stored AES-256-GCM encrypted and looked up
# by an HMAC-SHA256 hash. Required: startup fails without them, except under the dev/test Spring profiles, which use
# public built-in keys and log a WARN at startup. infra/compose/compose.yml DEFAULTS TO the dev profile: production must
# set SPRING_PROFILES_ACTIVE to a non-dev profile (e.g. prod) AND both keys below. Never commit real keys.
# HMS_FIELD_ENCRYPTION_KEYS: comma-separated keyId:base64key pairs (32-byte keys, e.g. `openssl rand -base64 32`).
#   The FIRST pair encrypts; the others only decrypt (rotation: prepend a new key, keep old ones until re-encrypted).
#   Key ids: 1-32 of [A-Za-z0-9_-]. Never reuse a key id for a different key.
# HMS_ABHA_HMAC_KEY: base64 of at least 32 bytes, separate from the encryption keys. Changing it breaks ABHA search
#   and the per-organization uniqueness check for existing rows, so treat it as permanent.
# SPRING_PROFILES_ACTIVE=
# HMS_FIELD_ENCRYPTION_KEYS=
# HMS_ABHA_HMAC_KEY=

# First-run bootstrap ([E2-1]). Optional: when no organization exists and these are set, the app creates the
# organization, the default roles and a System Administrator with a generated temporary password (change at first
# login). The password is written ONLY to the file named below (owner-only permissions where supported) and is never
# logged. On a fresh install, setting the name/email without the password file fails startup; once an organization
# exists the variables are ignored, so restarts never need them. HMS_BOOTSTRAP_ORG_TIMEZONE defaults to Asia/Kolkata.
# With Docker Compose use the mounted volume: HMS_BOOTSTRAP_ADMIN_PASSWORD_FILE=/var/lib/hms/bootstrap/admin-password.txt
# Read it with `docker compose ... exec api cat /var/lib/hms/bootstrap/admin-password.txt`, and DELETE the file
# (`... exec api rm /var/lib/hms/bootstrap/admin-password.txt`) right after the first login and password change.
# HMS_BOOTSTRAP_ORG_NAME=
# HMS_BOOTSTRAP_ADMIN_EMAIL=
# HMS_BOOTSTRAP_ORG_TIMEZONE=Asia/Kolkata
# HMS_BOOTSTRAP_ADMIN_PASSWORD_FILE=
