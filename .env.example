# Copy to .env for local development. Never commit real values.
# The backend reads these from the environment (see backend/src/main/resources/application.yml).

# PostgreSQL connection (database must exist; Flyway creates the `hms` schema)
HMS_DB_URL=jdbc:postgresql://localhost:5432/hms
HMS_DB_USERNAME=hms
HMS_DB_PASSWORD=change-me-local-only

# HTTP port of the backend
HMS_SERVER_PORT=8080
